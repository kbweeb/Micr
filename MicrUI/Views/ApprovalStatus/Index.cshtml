@model Domain.ViewModels.ApprovalStatuses.ApprovalStatusIndexViewModel

@{
    ViewData["Title"] = "Approval Statuses";
    var items = Model?.Items ?? new List<Domain.ViewModels.ApprovalStatuses.ApprovalStatusListItemViewModel>();
}

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h5 class="mb-0">Approval Statuses</h5>
            <small class="text-muted" data-role="count">@items.Count options available.</small>
        </div>
        <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#formModal" data-mode="add">
            <i class="bi bi-plus-circle me-1"></i> Add New
        </button>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle" id="dataTable">
                <thead class="table-light">
                    <tr>
                        <th>Approval Status</th>
                        <th>Created</th>
                        <th>Created By</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in items)
                    {
                        <tr>
                            <td class="fw-semibold">@item.ApprovalStatusName</td>
                            <td>@item.Created</td>
                            <td>@item.CreatedBy</td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#formModal"
                                        data-mode="edit" data-id="@item.ApprovalStatusId" data-name="@item.ApprovalStatusName">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="formModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Approval Status</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="dataForm" asp-action="CreateUpdate" method="post">
                    @Html.AntiForgeryToken()
                    <div class="alert alert-danger d-none" data-role="error"></div>
                    <input type="hidden" id="itemId" name="approvalStatusId" />
                    <div class="mb-3">
                        <label for="ApprovalStatusName" class="form-label">Approval Status Name <span class="text-danger">*</span></label>
                        <input class="form-control" type="text" id="ApprovalStatusName" name="ApprovalStatusName" maxlength="100" required />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-success" data-role="save">Save</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/duralux/vendors/js/dataTables.min.js" asp-append-version="true"></script>
    <script src="~/duralux/vendors/js/dataTables.bs5.min.js" asp-append-version="true"></script>
    <script>
        $(function () {
            const table = $('#dataTable').DataTable({ responsive: true });
            const modalEl = document.getElementById('formModal');
            const form = $('#dataForm');
            const saveBtn = $('[data-role="save"]');
            const errorBox = form.find('[data-role="error"]');

            const resetForm = () => {
                form[0].reset();
                $('#itemId').val('');
                errorBox.addClass('d-none').text('');
                saveBtn.prop('disabled', false).text('Save');
            };

            $('#formModal').on('show.bs.modal', function (e) {
                const btn = $(e.relatedTarget);
                const mode = btn.data('mode');
                resetForm();
                if (mode === 'edit') {
                    $('.modal-title').text('Edit Approval Status');
                    $('#itemId').val(btn.data('id'));
                    $('#ApprovalStatusName').val(btn.data('name'));
                    saveBtn.text('Update');
                } else {
                    $('.modal-title').text('Add Approval Status');
                }
            });

            saveBtn.on('click', () => form.trigger('submit'));

            form.on('submit', function (e) {
                e.preventDefault();
                errorBox.addClass('d-none');
                saveBtn.prop('disabled', true).text('Saving...');

                $.ajax({
                    url: '@Url.Action("CreateUpdate", "ApprovalStatus")',
                    method: 'POST',
                    data: form.serialize(),
                    success: function (res) {
                        if (res.success) {
                            location.reload();
                        } else {
                            errorBox.removeClass('d-none').text(res.messages || 'Error saving record.');
                            saveBtn.prop('disabled', false).text('Save');
                        }
                    },
                    error: function (xhr, status, error) {
                        errorBox.removeClass('d-none').text('Server error: ' + (xhr.responseText || error));
                        saveBtn.prop('disabled', false).text('Save');
                    }
                });
            });

            modalEl.addEventListener('hidden.bs.modal', resetForm);
        });
    </script>
}
